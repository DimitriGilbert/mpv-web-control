{
  "name": "mpv-web-control",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client --filter doc_site dev",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm -r --filter @mpv/contract --filter server --filter client --filter doc_site build",
    "typecheck": "pnpm -r --filter @mpv/contract --filter server --filter client --filter doc_site typecheck",
    "check-types": "pnpm typecheck",
    "start": "pnpm --filter server start",
    "dev:doc_site": "pnpm --filter doc_site dev"
  }
}
